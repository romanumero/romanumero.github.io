---
import { Image } from 'astro:assets';
import damon from '../assets/damon.jpg';
import type { Essay } from '../data/essays';
import { FORMAT_LABEL, readingTime } from '../data/essays';
import { trackById } from '../data/tracks';
import { PARTS } from '../data/book';
import FormattedDate from '../components/FormattedDate.astro';
import Subscribe from '../components/Subscribe.astro';
import Base from './Base.astro';

interface Props { essay: Essay }
const { essay } = Astro.props;
const { title, description, date, updated, track, format, part, youtube, draft } = essay.data;
const partInfo = part ? PARTS.find((p) => p.n === part) : undefined;
const minutes = readingTime(essay.body);
// Dev-only shortcut to the source file on GitHub.
const editUrl =
	essay.collection === 'drafts'
		? `https://github.com/romanumero/damonhenry-drafts/edit/main/${essay.filePath?.split('/').pop()}`
		: essay.filePath
			? `https://github.com/romanumero/romanumero.github.io/edit/master/${essay.filePath}`
			: undefined;
---

<Base title={title} description={description} type="article">
	<article class="col">
		{draft && <p class="draft-note">{essay.collection === 'drafts' ? <>Private draft (damonhenry-drafts). Publish with <code>npm run publish {essay.id}</code>.</> : <>Draft: visible in dev only. Set <code>draft: false</code> to publish.</>}</p>}
		<div class="eyebrow">
			{FORMAT_LABEL[format]} · <a href={`/tracks/${track}/`}>{trackById(track).label}</a>
			{partInfo && <> · Part {partInfo.roman}: {partInfo.title}</>}
		</div>
		<h1>{title}</h1>
		<p class="dek">{description}</p>
		<div class="by">
			<Image src={damon} alt="" width={40} height={40} class="av" />
			<div>
				Damon Henry · <FormattedDate date={date} /> · {minutes} min read
				{youtube && <> · <a href={youtube}>Watch the video</a></>}
				{updated && <div class="updated">Updated <FormattedDate date={updated} /></div>}
			</div>
		</div>

		<div class="prose"><slot /></div>

		<div class="end">
			<Subscribe heading="Get the next chapter first" blurb="Every essay here is a draft chapter of Engineering the Modern Agency. One email a month." />
			<p class="work">Want to go deeper with your team? <a href="/work/">See cohorts, toolkits and workshops →</a></p>
			{import.meta.env.DEV && editUrl && <p class="edit"><a href={editUrl}>Edit this post on GitHub</a></p>}
		</div>
	</article>
</Base>

<style>
	.col { max-width: 680px; margin: 0 auto; padding: 56px 24px 80px; }
	.draft-note { font: 13px var(--mono); background: var(--mark); padding: 8px 12px; border-radius: 6px; }
	.eyebrow a { text-decoration: none; }
	.eyebrow a:hover { color: var(--fg); }
	h1 { font: 500 clamp(36px, 5vw, 54px)/1.05 var(--serif); letter-spacing: -0.02em; margin: 14px 0 16px; }
	.dek { font: 20px/1.5 var(--serif); color: var(--s4); margin: 0; }
	.by { display: flex; align-items: center; gap: 12px; font: 14px var(--sans); color: var(--s3); margin: 24px 0 36px; padding-bottom: 26px; border-bottom: 1px solid var(--s2); }
	.by :global(.av) { width: 40px; height: 40px; flex: none; border-radius: 50%; object-fit: cover; filter: grayscale(1); }
	.updated { font-size: 13px; }

	.prose :global(p), .prose :global(li) { font: 20px/1.65 var(--serif); }
	.prose :global(p) { margin: 0 0 22px; }
	.prose > :global(p:first-child::first-letter) { float: left; font: 500 70px/0.82 var(--serif); margin: 6px 10px 0 0; }
	.prose :global(h2) { font: 600 26px/1.2 var(--display); letter-spacing: -0.01em; margin: 48px 0 14px; }
	.prose :global(h3) { font: 600 20px/1.3 var(--display); margin: 36px 0 10px; }
	.prose :global(ul), .prose :global(ol) { padding-left: 24px; margin: 0 0 22px; }
	.prose :global(li) { margin: 6px 0; }
	.prose :global(a) { text-decoration-thickness: 1px; text-underline-offset: 3px; }
	.prose :global(blockquote) { margin: 40px 0; padding: 0 0 0 24px; border-left: 3px solid var(--acc); }
	.prose :global(blockquote p) { font: italic 400 28px/1.35 var(--serif); }
	.prose :global(hr) { border: 0; border-top: 1px solid var(--s2); margin: 40px 0; }
	.prose :global(code) { font: 0.85em var(--mono); background: var(--s1); padding: 2px 5px; border-radius: 4px; }
	.prose :global(pre) { font: 13px/1.6 var(--mono); border-radius: 10px; padding: 18px; overflow: auto; margin: 0 0 24px; }
	.prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
	.prose :global(table) { width: 100%; border-collapse: collapse; font: 15px/1.5 var(--sans); margin: 0 0 24px; }
	.prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--s2); padding: 10px 8px; text-align: left; vertical-align: top; }
	.prose :global(details) { border: 1px solid var(--s2); border-radius: 12px; padding: 0 20px; margin: 28px 0; }
	.prose :global(summary) { cursor: pointer; padding: 16px 0; font: 600 15px var(--sans); }

	.end { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--s2); }
	.work, .edit { font: 15px var(--sans); color: var(--s4); margin: 20px 0 0; }
	.edit { font-size: 13px; }
	@media (max-width: 860px) { .prose :global(p), .prose :global(li) { font-size: 18px; } }
</style>

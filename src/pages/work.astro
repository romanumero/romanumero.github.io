---
import ContactButton from '../components/ContactButton.astro';
import Subscribe from '../components/Subscribe.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Work with me" description="Workshops, speaking and advisory for agency owners and their teams.">
	<div class="wrap">
		<header class="head">
			<div class="eyebrow">Work with me</div>
			<h1>Bring these ideas <span class="hl">into your agency.</span></h1>
			<p>The essays are free and always will be. If you want help putting them into practice with your team, here’s how I work.</p>
		</header>

		<section class="section" id="workshops">
			<div class="section-head"><h2>Workshops &amp; speaking</h2></div>
			<div class="ws">
				<p>Half-day working sessions for agency teams, industry associations and conferences. Popular topics: building your first AI eval, planning your first geo test, and mapping your agency’s workflows for automation.</p>
				<ContactButton label="Ask about dates" subject="Workshop / speaking inquiry" />
			</div>
		</section>

		<section class="section" id="advisory">
			<div class="section-head"><h2>Advisory</h2></div>
			<div class="ws">
				<p>I take a small number of ongoing advisory engagements with agency owners working through AI, automation and measurement. For hands-on media and measurement work, my team at <a href="https://www.kortx.io">KORTX</a> does it with you.</p>
				<ContactButton label="Start a conversation" subject="Advisory inquiry" />
			</div>
		</section>

		<section class="section cohort" id="cohort" style="border-bottom:0">
			<div>
				<div class="eyebrow">Considering · not scheduled</div>
				<h2>The AI-Ready Agency</h2>
				<p>I’m considering a small cohort: four weeks with a group of agency owners, each rebuilding one real workflow in their agency. Where AI fits, how to test that it’s right, and how to prove it moved a number the client cares about.</p>
				<p>It runs only if enough people want it. If you would, tell me below.</p>
			</div>
			<Subscribe heading="I’d join this" blurb="You’ll hear if and when it runs, before anyone else. No other emails from this list." form="cohort" cta="I’m interested" />
		</section>
	</div>
</Base>

<style>
	.head { padding: 64px 0 8px; max-width: 760px; }
	h1 { font: 500 clamp(38px, 5.2vw, 60px)/1.04 var(--serif); letter-spacing: -0.02em; margin: 12px 0 18px; }
	.head p { font: 19px/1.55 var(--serif); color: var(--s4); }
	.cohort { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: start; }
	.cohort h2 { font: 500 36px/1.1 var(--serif); margin: 10px 0 14px; }
	.cohort p { font: 18px/1.6 var(--serif); color: var(--s4); }
	.ws { display: flex; gap: 32px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
	.ws p { font: 18px/1.6 var(--serif); color: var(--s4); max-width: 640px; margin: 0; }
	@media (max-width: 860px) { .cohort { grid-template-columns: 1fr; } }
</style>

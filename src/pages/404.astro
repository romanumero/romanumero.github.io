---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
	<div class="wrap" style="padding:96px var(--gutter);max-width:720px">
		<div class="eyebrow">404</div>
		<h1 style="font:500 48px/1.05 var(--serif);margin:12px 0 16px">This page <span class="hl">doesn’t exist.</span></h1>
		<p style="font:19px/1.5 var(--serif);color:var(--s4)">It may have moved when the site was rebuilt. <a href="/essays/">Browse all essays →</a></p>
	</div>
</Base>

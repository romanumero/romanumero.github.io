---
// Static figure: the same question answered by a text model and by a decision model (e.g. Jev).
// Illustrative output, not a real model transcript.
interface Props {
	question?: string;
	prose?: string;
	options?: { label: string; p: number }[];
	confidence?: number;
	caption?: string;
}
const {
	question = 'Is the search term “north field shoes” branded, competitor, generic or irrelevant?',
	prose = 'Great question! “North field shoes” is most likely a branded search. It closely resembles the brand name Northfield, and the added space is a common misspelling. That said, it could also refer to shoes for a sports field, or to other brands with similar names, so you may want to review it in context before making a final decision.',
	options = [
		{ label: 'Branded', p: 0.94 },
		{ label: 'Generic', p: 0.04 },
		{ label: 'Competitor', p: 0.015 },
		{ label: 'Irrelevant', p: 0.005 },
	],
	confidence = 0.93,
	caption = 'Illustrative. Both answers are the same call; only one can go straight into a rule.',
} = Astro.props;
const top = options.reduce((a, b) => (b.p > a.p ? b : a));
const pct = (n: number) => (n < 0.01 ? '<1%' : `${Math.round(n * 100)}%`);
---
<figure class="wvd">
	<p class="q"><small>The question</small>{question}</p>
	<div class="cols">
		<div class="col">
			<small>A chat model writes</small>
			<p class="prose">{prose}</p>
			<p class="foot">Someone still has to read it and decide.</p>
		</div>
		<div class="col dec">
			<small>A decision model returns</small>
			<p class="answer"><b>{top.label}</b></p>
			<ul>
				{options.map((o) => (
					<li class={o === top ? 'top' : ''}>
						<span>{o.label}</span>
						<span class="bar"><i style={`width:${Math.max(o.p * 100, 1)}%`} /></span>
						<output>{pct(o.p)}</output>
					</li>
				))}
			</ul>
			<p class="foot">Confidence <b>{pct(confidence)}</b>. Software can act on this directly.</p>
		</div>
	</div>
	<figcaption>{caption}</figcaption>
</figure>
<style>
	.wvd { border: 1.5px solid var(--fg); border-radius: 18px; padding: 24px; margin: 36px -40px; font-family: var(--sans); }
	small { display: block; font: 700 11px var(--display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--s3); margin: 0 0 8px; }
	.q { font: 600 18px/1.35 var(--display) !important; margin: 0 0 20px !important; }
	.cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
	.col { border: 1px solid var(--s2); border-radius: 12px; padding: 16px; display: flex; flex-direction: column; }
	.prose { font: 14.5px/1.55 var(--serif) !important; color: var(--s4); margin: 0 !important; flex: 1; }
	.dec { background: var(--s1); border-color: var(--s1); }
	.answer { margin: 0 0 12px !important; }
	.answer b { font: 700 26px var(--display); background: linear-gradient(transparent 55%, var(--mark) 55%); }
	ul { list-style: none; margin: 0 !important; padding: 0 !important; flex: 1; }
	li { display: grid; grid-template-columns: 88px 1fr 40px; gap: 10px; align-items: center; font: 13.5px/1.3 var(--sans) !important; margin: 7px 0 !important; padding: 0 !important; }
	li::before, li::marker { content: none; }
	li.top { font-weight: 600; }
	.bar { height: 10px; background: var(--bg); border-radius: 5px; overflow: hidden; }
	.bar i { display: block; height: 100%; background: var(--s3); border-radius: 5px; }
	li.top .bar i { background: var(--fg); }
	output { font: 500 12.5px var(--mono); text-align: right; }
	.foot { font: 13px/1.45 var(--sans) !important; color: var(--s4); margin: 14px 0 0 !important; }
	figcaption { font: 12px var(--mono); color: var(--s3); margin-top: 14px; }
	@media (max-width: 860px) {
		.wvd { margin: 32px 0; padding: 18px; }
		.cols { grid-template-columns: 1fr; }
	}
</style>

---
// Usage in MDX: <Monday> 1. First step … </Monday>  (write a normal Markdown list inside)
interface Props { title?: string }
const { title = 'What to do Monday' } = Astro.props;
---
<aside class="monday">
	<h4>{title}</h4>
	<slot />
</aside>
<style>
	.monday { background: var(--s1); border-radius: 16px; padding: 26px 28px; margin: 40px 0; }
	h4 { font: 600 12px var(--display); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 12px; }
	.monday :global(ol), .monday :global(ul) { margin: 0; padding-left: 20px; font: 16px/1.6 var(--sans) !important; }
	.monday :global(li) { margin: 6px 0; }
	.monday :global(p) { font: 16px/1.6 var(--sans) !important; margin: 0 !important; }
</style>
